          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "lineInterpolation": "linear",
            "fillOpacity": 25,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "barAlignment": 0
