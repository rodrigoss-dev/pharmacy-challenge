# The backend. The web app has its own image (web/Dockerfile).
FROM eclipse-temurin:21-jdk AS build
WORKDIR /src
COPY . .
RUN ./gradlew :infra:quarkusBuild --no-daemon --console=plain

FROM eclipse-temurin:21-jre
WORKDIR /app
# Quarkus' fast-jar layout: dependencies, generated bytecode and the app in separate layers.
COPY --from=build /src/infra/build/quarkus-app/lib/ /app/lib/
COPY --from=build /src/infra/build/quarkus-app/*.jar /app/
COPY --from=build /src/infra/build/quarkus-app/app/ /app/app/
COPY --from=build /src/infra/build/quarkus-app/quarkus/ /app/quarkus/
ENV PORT=8080
EXPOSE 8080
CMD ["java", "-jar", "/app/quarkus-run.jar"]
